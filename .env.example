# Copilote projet — copy to .env (Docker) or .env.local (npm run dev / CLI). Never commit the real file.

# Claude API key (console.anthropic.com). Required to answer questions.
ANTHROPIC_API_KEY=

# Login asked by the page (user "phenix" unless COPILOTE_USER is set). Required on a server.
COPILOTE_PASSWORD=
# COPILOTE_USER=phenix

# Folder of project documents the indexer watches (Docker: host path, mounted read-only).
DOCS_DIR=./docs-projet

# Optional
# COPILOTE_MODEL=claude-opus-5-5        # model that answers
# COPILOTE_EFFORT=medium                # low | medium | high
# COPILOTE_VERIFY=off                   # turn off the second-reader check (Claude Haiku 5.5)
# COPILOTE_PROJECT=...                  # one-line project description given to the model
# EMBEDDINGS=local                      # Docker build arg: add on-machine dense retrieval
# COPILOTE_WATCH_MINUTES=5
# PORT=3000
