# Optional. Nothing here is required: run `npm run copilot` and the page asks for what it needs.
#
# Claude runs through the Claude Code CLI signed in with your subscription (claude auth login).
# MEETING_MODEL=opus            # digest, Q&A, learning
# MEETING_MODEL_CHUNK=sonnet    # per-chunk transcript fidelity pass (runs every ~45 s)
# CLAUDE_BIN=claude             # path to the CLI if it isn't on PATH

# Where the agent's memory lives (knowledge base, confirmed names, notes, tracker, past meetings)
# MEETING_WORKSPACE=./workspace

# ── Speech-to-text (separate service, billed by that provider) ────────────
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# OPENAI_API_KEY=
# STT_MODEL=scribe_v2            # or gpt-4o-transcribe-diarize with STT_PROVIDER=openai

# Set this if anyone else can reach the machine running the app. Enter the same value in the UI.
MEETING_ACCESS_KEY=
